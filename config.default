# ── herdr-spawn: configuration ───────────────────────────────────────
# This file is sourced by bash: key=value syntax, no spaces around "=".
# It lives in the plugin config dir (`herdr plugin config-dir herdr-spawn`)
# and belongs to you.

# Agent launched by default (supported kinds: `herdr agent start --help`).
kind=claude

# Prefix for the branches/worktrees created.
branch_prefix=agent/

# Give focus to the agent pane after launch (true/false).
# false: the sidebar and notifications track its state.
focus=false

# Split direction in --here mode (right/down).
here_direction=right

# Base ref for worktrees (empty = current branch).
base=

# Number of prompts kept in history (↑ in the popup).
history_size=200
